// ReadinessRequirement entity - Individual verification requirement for an operation
// SECURITY NOTE: status and ownerUserId writes must be restricted to backend functions.
// RLS rules required (to be defined with Base44 RLS syntax).
{
  "name": "ReadinessRequirement",
  "type": "object",
  "description": "Individual verification requirement. status and ownerUserId writes restricted to backend functions.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to parent Operation (stored as string ID)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable requirement label"
    },
    "category": {
      "type": "string",
      "description": "Category for grouping (e.g., Safety, Personnel, Equipment)"
    },
    "criticality": {
      "type": "string",
      "enum": ["CRITICAL", "STANDARD"],
      "description": "Importance level affecting operation readiness"
    },
    "status": {
      "type": "string",
      "enum": ["SATISFIED", "UNOWNED", "OWNED", "EVIDENCE_SUBMITTED", "VERIFIED", "REJECTED"],
      "description": "Current verification state. Clients can read; only backend functions can write."
    },
    "ownerUserId": {
      "type": "string",
      "description": "User ID of owner accepting this requirement (empty string if unowned). Clients can read; only backend acceptOwnership can write."
    },
    "evidenceRequired": {
      "type": "boolean",
      "description": "Whether evidence must be submitted"
    },
    "verificationRequired": {
      "type": "boolean",
      "description": "Whether independent verification is required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "required": ["operationId", "label", "category", "criticality", "status", "evidenceRequired", "verificationRequired", "createdAt"]
}
