// ReadinessRequirement entity - Individual verification requirement for an operation
// status modification is restricted to backend functions (acceptOwnership, submitEvidence, verifyEvidence, etc.)
{
  "name": "ReadinessRequirement",
  "type": "object",
  "description": "Individual verification requirement that must be satisfied for operational readiness",
  "properties": {
    "operationId": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to parent Operation"
    },
    "label": {
      "type": "string",
      "description": "Human-readable requirement label"
    },
    "category": {
      "type": "string",
      "description": "Category for grouping (e.g., Safety, Personnel, Equipment)"
    },
    "criticality": {
      "type": "string",
      "enum": ["CRITICAL", "STANDARD"],
      "description": "Importance level affecting operation readiness"
    },
    "status": {
      "type": "string",
      "enum": ["SATISFIED", "UNOWNED", "OWNED", "EVIDENCE_SUBMITTED", "VERIFIED", "REJECTED"],
      "description": "Current verification state; modified only by backend functions"
    },
    "ownerUserId": {
      "type": "string",
      "description": "User ID of owner accepting this requirement; empty string if unowned"
    },
    "evidenceRequired": {
      "type": "boolean",
      "description": "Whether evidence must be submitted"
    },
    "verificationRequired": {
      "type": "boolean",
      "description": "Whether independent verification is required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "required": ["operationId", "label", "category", "criticality", "status", "evidenceRequired", "verificationRequired", "createdAt"]
}
