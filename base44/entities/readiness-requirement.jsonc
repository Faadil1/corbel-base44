{
  "name": "ReadinessRequirement",
  "type": "object",
  "description": "Individual verification requirement. All mutations through backend functions.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to parent Operation"
    },
    "label": {
      "type": "string",
      "description": "Human-readable requirement label"
    },
    "category": {
      "type": "string",
      "description": "Category for grouping (e.g., Safety, Personnel, Equipment)"
    },
    "criticality": {
      "type": "string",
      "enum": ["CRITICAL", "STANDARD"],
      "description": "Importance level affecting operation readiness"
    },
    "status": {
      "type": "string",
      "enum": ["SATISFIED", "UNOWNED", "OWNED", "EVIDENCE_SUBMITTED", "VERIFIED", "REJECTED"],
      "description": "Current verification state (SATISFIED/UNOWNED/OWNED/EVIDENCE_SUBMITTED/VERIFIED/REJECTED). Read-only to clients.",
      "write": false
    },
    "ownerUserId": {
      "type": "string",
      "description": "User ID of owner accepting this requirement (empty if unowned). Read-only to clients; written by acceptOwnership.",
      "write": false
    },
    "evidenceRequired": {
      "type": "boolean",
      "description": "Whether evidence must be submitted"
    },
    "verificationRequired": {
      "type": "boolean",
      "description": "Whether independent verification is required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "required": ["operationId", "label", "category", "criticality", "status", "evidenceRequired", "verificationRequired", "createdAt"],
  "create": false,
  "read": {
    "user_condition": {
      "id": "{{user.id}}"
    }
  },
  "update": false,
  "delete": false
}
