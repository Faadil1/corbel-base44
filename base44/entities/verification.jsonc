{
  "name": "Verification",
  "type": "object",
  "description": "Independent verification decision on submitted evidence. All mutations through verifyEvidence function.",
  "properties": {
    "requirementId": {
      "type": "string",
      "description": "Reference to ReadinessRequirement"
    },
    "verifierUserId": {
      "type": "string",
      "description": "User ID of independent verifier (cannot be the evidence submitter)"
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"],
      "description": "Verification decision"
    },
    "note": {
      "type": "string",
      "format": "richtext",
      "description": "Verifier's reasoning or explanation"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Verification decision timestamp"
    }
  },
  "required": ["requirementId", "verifierUserId", "decision", "note", "verifiedAt"],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
