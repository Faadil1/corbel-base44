// Verification entity - Independent review and approval/rejection of evidence
// Only created via verifyEvidence function; verifier cannot verify their own evidence
{
  "name": "Verification",
  "type": "object",
  "description": "Independent verification decision on submitted evidence",
  "properties": {
    "requirementId": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to ReadinessRequirement"
    },
    "verifierUserId": {
      "type": "string",
      "description": "User ID of independent verifier (cannot be the evidence submitter)"
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"],
      "description": "Verification decision"
    },
    "note": {
      "type": "string",
      "format": "richtext",
      "description": "Verifier's reasoning or explanation"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Verification decision timestamp"
    }
  },
  "required": ["requirementId", "verifierUserId", "decision", "note", "verifiedAt"]
}
