// Operation entity - Primary work unit for release control
// currentState modification is restricted to backend recalculateReadiness function
{
  "name": "Operation",
  "type": "object",
  "description": "Primary work unit with operational readiness state",
  "properties": {
    "name": {
      "type": "string",
      "description": "Operation name"
    },
    "location": {
      "type": "string",
      "description": "Geographic or facility location"
    },
    "currentState": {
      "type": "string",
      "enum": ["READY", "HOLD_UNOWNED", "HOLD_OWNED", "VERIFYING"],
      "description": "Current readiness state; modified only by recalculateReadiness function"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    }
  },
  "required": ["name", "location", "currentState", "createdAt", "updatedAt"]
}
