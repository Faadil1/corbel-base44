// Operation entity - Primary work unit for release control
// SECURITY NOTE: currentState write access must be restricted to backend recalculateReadiness function.
// RLS rules required (to be defined with Base44 RLS syntax).
{
  "name": "Operation",
  "type": "object",
  "description": "Primary work unit with operational readiness state. currentState writes restricted to backend function.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Operation name"
    },
    "location": {
      "type": "string",
      "description": "Geographic or facility location"
    },
    "currentState": {
      "type": "string",
      "enum": ["READY", "HOLD_UNOWNED", "HOLD_OWNED", "VERIFYING"],
      "description": "Current readiness state. Clients can read; only backend recalculateReadiness can write."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    }
  },
  "required": ["name", "location", "currentState", "createdAt", "updatedAt"]
}
