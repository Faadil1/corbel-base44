{
  "name": "Operation",
  "type": "object",
  "description": "Primary work unit with operational readiness state. All mutations through backend functions.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Operation name"
    },
    "location": {
      "type": "string",
      "description": "Geographic or facility location"
    },
    "currentState": {
      "type": "string",
      "enum": ["READY", "HOLD", "VERIFYING", "RELEASED"],
      "description": "Current readiness state (READY/HOLD/VERIFYING/RELEASED). Read-only to clients; written by recalculateReadiness.",
      "write": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    }
  },
  "required": ["name", "location", "currentState", "createdAt", "updatedAt"],
  "create": false,
  "read": {
    "user_condition": {
      "id": "{{user.id}}"
    }
  },
  "update": false,
  "delete": false
}
