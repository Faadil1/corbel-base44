{
  "name": "OperationalEvent",
  "type": "object",
  "description": "Append-restricted audit log entry for operation state changes and actions.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to Operation"
    },
    "eventType": {
      "type": "string",
      "description": "Type of event (OWNERSHIP_ACCEPTED, EVIDENCE_SUBMITTED, VERIFICATION_APPROVED, STATE_CHANGED, etc.)"
    },
    "actorUserId": {
      "type": "string",
      "description": "User ID of actor causing the event (or 'system' for automated events)"
    },
    "previousState": {
      "type": "string",
      "description": "State before this event (empty if not applicable)"
    },
    "newState": {
      "type": "string",
      "description": "State after this event (empty if not applicable)"
    },
    "message": {
      "type": "string",
      "format": "richtext",
      "description": "Human-readable description of the event"
    },
    "metadata": {
      "type": "object",
      "description": "Event-specific data (requirementId, userId, etc.)"
    },
    "previousEventHash": {
      "type": "string",
      "description": "Hash of previous event in chain (empty for first event). Read-only to clients.",
      "write": false
    },
    "eventHash": {
      "type": "string",
      "description": "Cryptographic hash of this event (includes all fields and previous hash). Read-only to clients.",
      "write": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp"
    }
  },
  "required": ["operationId", "eventType", "actorUserId", "message", "createdAt"],
  "create": false,
  "read": {
    "user_condition": {
      "id": "{{user.id}}"
    }
  },
  "update": false,
  "delete": false
}
