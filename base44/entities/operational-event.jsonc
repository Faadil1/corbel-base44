// OperationalEvent entity - Audit log of state changes and actions
// SECURITY NOTE: Clients should not create, update, or delete events.
// Events created exclusively by backend functions to record state transitions.
// RLS rules required to prevent client writes (to be defined with Base44 RLS syntax).
{
  "name": "OperationalEvent",
  "type": "object",
  "description": "Append-restricted audit log entry for operation state changes and actions. Client writes should be denied via RLS.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to Operation"
    },
    "eventType": {
      "type": "string",
      "description": "Type of event (e.g., OWNERSHIP_ACCEPTED, EVIDENCE_SUBMITTED, VERIFICATION_APPROVED, STATE_CHANGED)"
    },
    "actorUserId": {
      "type": "string",
      "description": "User ID of actor causing the event (or 'system' for automated events)"
    },
    "previousState": {
      "type": "string",
      "description": "State before this event (empty if not applicable)"
    },
    "newState": {
      "type": "string",
      "description": "State after this event (empty if not applicable)"
    },
    "message": {
      "type": "string",
      "format": "richtext",
      "description": "Human-readable description of the event"
    },
    "metadata": {
      "type": "object",
      "description": "Event-specific data (requirementId, userId, etc.)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp"
    }
  },
  "required": ["operationId", "eventType", "actorUserId", "message", "createdAt"]
}
