// ReleaseReceipt entity - Tamper-evident proof of release
// SECURITY NOTE: Clients should not create, update, or delete receipts.
// Receipts generated exclusively by generateReleaseReceipt function when operation transitions to RELEASED.
// RLS rules required to prevent client writes (to be defined with Base44 RLS syntax).
{
  "name": "ReleaseReceipt",
  "type": "object",
  "description": "Tamper-evident receipt proving an operation was released. Client writes should be denied via RLS.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to released Operation"
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["RELEASED"],
      "description": "Always RELEASED; exists only when operation reaches that state"
    },
    "eventChain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sequence of event IDs leading to release (for audit trail)"
    },
    "receiptHash": {
      "type": "string",
      "format": "regex",
      "description": "Cryptographic hash of all preceding events (tamper-evidence)"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Receipt generation timestamp"
    }
  },
  "required": ["operationId", "releaseStatus", "eventChain", "receiptHash", "generatedAt"]
}
