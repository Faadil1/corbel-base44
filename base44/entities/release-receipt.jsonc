{
  "name": "ReleaseReceipt",
  "type": "object",
  "description": "Tamper-evident operational receipt proving an operation was released.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to released Operation"
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["RELEASED"],
      "description": "Always RELEASED; exists only when operation reaches that state"
    },
    "eventChain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sequence of event IDs leading to release (audit trail)"
    },
    "receiptHash": {
      "type": "string",
      "description": "Cryptographic hash of all preceding events (tamper-evidence). Read-only to clients.",
      "write": false
    },
    "eventChainHeadHash": {
      "type": "string",
      "description": "Hash of the final event in the chain. Read-only to clients.",
      "write": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Receipt generation timestamp"
    }
  },
  "required": ["operationId", "releaseStatus", "eventChain", "receiptHash", "generatedAt"],
  "create": false,
  "read": {
    "user_condition": {
      "id": "{{user.id}}"
    }
  },
  "update": false,
  "delete": false
}
