{
  "name": "HazardReport",
  "type": "object",
  "description": "Detected operational hazard that may trigger state transitions.",
  "properties": {
    "operationId": {
      "type": "string",
      "description": "Reference to parent Operation"
    },
    "requirementId": {
      "type": "string",
      "description": "Reference to related ReadinessRequirement"
    },
    "reportedBy": {
      "type": "string",
      "description": "User ID of hazard reporter"
    },
    "title": {
      "type": "string",
      "description": "Hazard title"
    },
    "description": {
      "type": "string",
      "format": "richtext",
      "description": "Detailed hazard description"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Hazard severity level"
    },
    "photoUrl": {
      "type": "string",
      "format": "uri",
      "description": "Photo URL documenting the hazard (empty if none)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Report timestamp"
    }
  },
  "required": ["operationId", "requirementId", "reportedBy", "title", "description", "severity", "createdAt"],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
